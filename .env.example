# Local dev only — never commit this file or deploy it to Streamlit secrets.
#
# Model A (sharing): each user pastes their own key in the app sidebar.
# For solo local dev with auto-load from .env, uncomment both lines below:
#
# FITLINE_BYO_KEY=0
# GEMINI_API_KEY=your_key_here
#
# Optional — show registered-user count in sidebar (your email only):
# FITLINE_ADMIN_EMAIL=you@email.com
#
# Optional — POST feedback JSON to a webhook (Formspree, Slack, etc.):
# FEEDBACK_WEBHOOK_URL=https://...
#
# Get a free key: https://aistudio.google.com/apikey
